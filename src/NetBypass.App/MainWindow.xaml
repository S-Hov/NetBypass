<Window x:Class="NetBypass.App.MainWindow"
        xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="NetBypass" Width="1180" Height="760"
        MinWidth="940" MinHeight="640"
        WindowStartupLocation="CenterScreen"
        Background="#090B12" TransparencyLevelHint="Mica,Blur">
  <Window.Resources>
    <SolidColorBrush x:Key="AccentBrush" Color="#7B63FF" />
    <SolidColorBrush x:Key="AccentSoftBrush" Color="#2B244F" />
    <SolidColorBrush x:Key="PanelBrush" Color="#111520" />
    <SolidColorBrush x:Key="CardBrush" Color="#151A27" />
    <SolidColorBrush x:Key="LineBrush" Color="#252B3A" />
    <SolidColorBrush x:Key="MutedBrush" Color="#8E96AA" />
    <SolidColorBrush x:Key="QuietBrush" Color="#626A7D" />
    <SolidColorBrush x:Key="GreenBrush" Color="#64E5B3" />
  </Window.Resources>

  <Window.Styles>
    <Style Selector="Border.card">
      <Setter Property="Background" Value="{StaticResource CardBrush}" />
      <Setter Property="BorderBrush" Value="{StaticResource LineBrush}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="CornerRadius" Value="18" />
      <Setter Property="Padding" Value="22" />
      <Setter Property="BoxShadow" Value="0 14 36 0 #26000000" />
    </Style>
    <Style Selector="TextBlock.eyebrow">
      <Setter Property="Foreground" Value="#8B7CFF" />
      <Setter Property="FontSize" Value="11" />
      <Setter Property="FontWeight" Value="Bold" />
      <Setter Property="LetterSpacing" Value="1.4" />
    </Style>
    <Style Selector="TextBlock.title">
      <Setter Property="FontSize" Value="28" />
      <Setter Property="FontWeight" Value="Bold" />
      <Setter Property="Foreground" Value="#F7F8FC" />
    </Style>
    <Style Selector="TextBlock.subtitle">
      <Setter Property="FontSize" Value="14" />
      <Setter Property="Foreground" Value="{StaticResource MutedBrush}" />
    </Style>
    <Style Selector="TextBlock.sectionTitle">
      <Setter Property="FontSize" Value="17" />
      <Setter Property="FontWeight" Value="SemiBold" />
      <Setter Property="Foreground" Value="#F1F3FA" />
    </Style>
    <Style Selector="Button.nav">
      <Setter Property="HorizontalContentAlignment" Value="Stretch" />
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderBrush" Value="Transparent" />
      <Setter Property="Foreground" Value="#858DA1" />
      <Setter Property="Padding" Value="13,11" />
      <Setter Property="Margin" Value="0,3" />
    </Style>
    <Style Selector="Button.nav:pointerover">
      <Setter Property="Background" Value="#171C29" />
      <Setter Property="Foreground" Value="#F0F2F8" />
      <Setter Property="BorderBrush" Value="#202737" />
    </Style>
    <Style Selector="Button.nav.active">
      <Setter Property="Background" Value="#211D3B" />
      <Setter Property="Foreground" Value="#C9C1FF" />
      <Setter Property="BorderBrush" Value="#42376F" />
    </Style>
    <Style Selector="Border.serviceCard:pointerover">
      <Setter Property="Background" Value="#1A2030" />
      <Setter Property="BorderBrush" Value="#3A4359" />
    </Style>
    <Style Selector="Border.serviceCard">
      <Setter Property="Transitions">
        <Transitions>
          <BrushTransition Property="Background" Duration="0:0:0.16" />
          <BrushTransition Property="BorderBrush" Duration="0:0:0.16" />
        </Transitions>
      </Setter>
    </Style>
    <Style Selector="ProgressBar">
      <Setter Property="Height" Value="6" />
      <Setter Property="Foreground" Value="{StaticResource AccentBrush}" />
      <Setter Property="Background" Value="#272D3D" />
      <Setter Property="CornerRadius" Value="3" />
    </Style>
    <Style Selector="Button.power">
      <Style.Animations>
        <Animation Duration="0:0:2.4" IterationCount="Infinite" PlaybackDirection="Alternate" Easing="SineEaseInOut">
          <KeyFrame Cue="0%"><Setter Property="Opacity" Value="0.82" /></KeyFrame>
          <KeyFrame Cue="100%"><Setter Property="Opacity" Value="1" /></KeyFrame>
        </Animation>
      </Style.Animations>
    </Style>
    <Style Selector="Border.liveDot">
      <Style.Animations>
        <Animation Duration="0:0:1.7" IterationCount="Infinite" PlaybackDirection="Alternate" Easing="SineEaseInOut">
          <KeyFrame Cue="0%"><Setter Property="Opacity" Value="0.4" /></KeyFrame>
          <KeyFrame Cue="100%"><Setter Property="Opacity" Value="1" /></KeyFrame>
        </Animation>
      </Style.Animations>
    </Style>
  </Window.Styles>

  <Grid>
    <Grid ColumnDefinitions="232,*">
      <Border Grid.Column="0" Background="#0E111A" BorderBrush="#202534" BorderThickness="0,0,1,0">
        <Grid Margin="20,24" RowDefinitions="Auto,Auto,*,Auto">
          <StackPanel Orientation="Horizontal" Spacing="11">
            <Border Width="38" Height="38" CornerRadius="12" Background="#7B63FF" BoxShadow="0 7 22 0 #607B63FF">
              <Grid>
                <Border Width="17" Height="17" CornerRadius="9" BorderThickness="3" BorderBrush="White" />
                <Border Width="5" Height="5" CornerRadius="3" Background="White" />
              </Grid>
            </Border>
            <StackPanel VerticalAlignment="Center" Spacing="1">
              <TextBlock Text="NetBypass" FontSize="18" FontWeight="Bold" />
              <TextBlock Text="NETWORK CONTROL" FontSize="8" LetterSpacing="1.6" Foreground="#6F778A" />
            </StackPanel>
          </StackPanel>

          <StackPanel Grid.Row="1" Margin="0,34,0,0">
            <TextBlock Text="РАЗДЕЛЫ" Classes="eyebrow" Margin="12,0,0,8" Foreground="#596174" />
            <Button Classes="nav" Classes.active="{Binding IsHomePage}" Command="{Binding ShowHomeCommand}">
              <Grid ColumnDefinitions="30,*"><TextBlock Text="●" FontSize="11" VerticalAlignment="Center" /><TextBlock Grid.Column="1" Text="Главная" /></Grid>
            </Button>
            <Button Classes="nav" Classes.active="{Binding IsServicesPage}" Command="{Binding ShowServicesCommand}">
              <Grid ColumnDefinitions="30,*"><TextBlock Text="◈" FontSize="16" VerticalAlignment="Center" /><TextBlock Grid.Column="1" Text="Сервисы" /></Grid>
            </Button>
            <Button Classes="nav" Classes.active="{Binding IsEnginesPage}" Command="{Binding ShowEnginesCommand}">
              <Grid ColumnDefinitions="30,*"><TextBlock Text="⌁" FontSize="20" VerticalAlignment="Center" /><TextBlock Grid.Column="1" Text="Движки" /></Grid>
            </Button>
            <Button Classes="nav" Classes.active="{Binding IsDiagnosticsPage}" Command="{Binding ShowDiagnosticsCommand}">
              <Grid ColumnDefinitions="30,*"><TextBlock Text="⌁" FontSize="20" VerticalAlignment="Center" /><TextBlock Grid.Column="1" Text="Диагностика" /></Grid>
            </Button>
            <Button Classes="nav" Classes.active="{Binding IsSettingsPage}" Command="{Binding ShowSettingsCommand}">
              <Grid ColumnDefinitions="30,*"><TextBlock Text="⚙" FontSize="16" VerticalAlignment="Center" /><TextBlock Grid.Column="1" Text="Настройки" /></Grid>
            </Button>
          </StackPanel>

          <Border Grid.Row="3" Classes="card" Padding="14" CornerRadius="13" Background="#121722">
            <Grid ColumnDefinitions="Auto,*">
              <Border Width="8" Height="8" CornerRadius="4" Background="#64E5B3" VerticalAlignment="Top" Margin="0,4,10,0" BoxShadow="0 0 12 1 #8064E5B3" />
              <StackPanel Grid.Column="1" Spacing="3">
                <TextBlock Text="Системный режим" FontSize="12" FontWeight="SemiBold" />
                <TextBlock Text="Права администратора активны" FontSize="10" Foreground="{StaticResource QuietBrush}" TextWrapping="Wrap" />
              </StackPanel>
            </Grid>
          </Border>
        </Grid>
      </Border>

      <Grid Grid.Column="1">
        <Border Height="260" VerticalAlignment="Top" IsHitTestVisible="False">
          <Border.Background>
            <RadialGradientBrush Center="70%,0%" GradientOrigin="70%,0%" RadiusX="0.7" RadiusY="0.7">
              <GradientStop Color="#2C244E" Offset="0" />
              <GradientStop Color="#00090B12" Offset="1" />
            </RadialGradientBrush>
          </Border.Background>
        </Border>

        <!-- HOME -->
        <ScrollViewer IsVisible="{Binding IsHomePage}" VerticalScrollBarVisibility="Auto">
          <StackPanel Margin="38,32,38,40" Spacing="22">
            <Grid ColumnDefinitions="*,Auto">
              <StackPanel Spacing="5">
                <TextBlock Text="СОСТОЯНИЕ СЕТИ" Classes="eyebrow" />
                <TextBlock Text="Центр управления" Classes="title" />
                <TextBlock Text="Один спокойный экран для контроля маршрутизации и Anti-DPI." Classes="subtitle" />
              </StackPanel>
              <Border Grid.Column="1" CornerRadius="20" Padding="13,8" Background="#151B27" BorderBrush="#293145" BorderThickness="1">
                <StackPanel Orientation="Horizontal" Spacing="8"><Border Classes="liveDot" Width="7" Height="7" CornerRadius="4" Background="{Binding StateAccent}" VerticalAlignment="Center" /><TextBlock Text="LIVE STATUS" FontSize="10" FontWeight="Bold" LetterSpacing="1" Foreground="#AEB5C7" /></StackPanel>
              </Border>
            </Grid>

            <Grid ColumnDefinitions="1.15*,0.85*" ColumnSpacing="18">
              <Border Classes="card" Padding="28" MinHeight="338">
                <Grid RowDefinitions="Auto,*,Auto">
                  <Grid ColumnDefinitions="*,Auto">
                    <StackPanel Spacing="6">
                      <TextBlock Text="ЗАЩИЩЁННЫЙ МАРШРУТ" Classes="eyebrow" />
                      <TextBlock Text="{Binding StateTitle}" FontSize="23" FontWeight="Bold" />
                      <TextBlock Text="{Binding StateDescription}" MaxWidth="440" Classes="subtitle" TextWrapping="Wrap" />
                    </StackPanel>
                    <Border Grid.Column="1" Width="50" Height="50" CornerRadius="25" Background="#111621" BorderBrush="{Binding StateAccent}" BorderThickness="1">
                      <TextBlock Text="N" FontSize="18" FontWeight="Bold" Foreground="{Binding StateAccent}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                  </Grid>

                  <Button Grid.Row="1" Classes="power" Command="{Binding PowerCommand}" Width="172" Height="172" Padding="0" Margin="0,14" HorizontalAlignment="Center" CornerRadius="86" Background="#101520" BorderBrush="{Binding StateAccent}" BorderThickness="2">
                    <Grid>
                      <Border Margin="13" CornerRadius="72" BorderBrush="{Binding StateAccent}" BorderThickness="1" Opacity="0.22" />
                      <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Spacing="7">
                        <TextBlock Text="⏻" FontSize="40" Foreground="{Binding StateAccent}" HorizontalAlignment="Center" />
                        <TextBlock Text="{Binding PowerButtonLabel}" FontSize="12" FontWeight="Bold" />
                      </StackPanel>
                    </Grid>
                  </Button>

                  <Border Grid.Row="2" IsVisible="{Binding HasOperationMessage}" CornerRadius="11" Background="#111722" Padding="13,10">
                    <TextBlock Text="{Binding OperationMessage}" FontSize="12" Foreground="#B7BECE" TextWrapping="Wrap" HorizontalAlignment="Center" />
                  </Border>
                </Grid>
              </Border>

              <StackPanel Grid.Column="1" Spacing="18">
                <Border Classes="card">
                  <StackPanel Spacing="12">
                    <Grid ColumnDefinitions="*,Auto"><TextBlock Text="Быстрый обзор" Classes="sectionTitle" /><TextBlock Grid.Column="1" Text="01" Classes="eyebrow" Foreground="#555E72" /></Grid>
                    <Border Height="1" Background="{StaticResource LineBrush}" />
                    <Grid ColumnDefinitions="*,Auto"><TextBlock Text="Выбрано сервисов" Classes="subtitle" /><TextBlock Grid.Column="1" Text="{Binding SelectedServiceCount}" FontSize="19" FontWeight="Bold" /></Grid>
                    <Grid ColumnDefinitions="*,Auto"><TextBlock Text="GoodbyeDPI" Classes="subtitle" /><TextBlock Grid.Column="1" Text="{Binding GoodbyeDpiRuntimeStatus}" MaxWidth="155" TextWrapping="Wrap" TextAlignment="Right" FontSize="10" Foreground="#9DA5B8" /></Grid>
                  </StackPanel>
                </Border>
                <Border Classes="card" Background="#17152A" BorderBrush="#38305D">
                  <StackPanel Spacing="10">
                    <TextBlock Text="Фоновая работа" Classes="sectionTitle" />
                    <TextBlock Text="NetBypass восстановит выбранную конфигурацию после входа в Windows." Classes="subtitle" TextWrapping="Wrap" />
                    <Button Command="{Binding ShowSettingsCommand}" HorizontalAlignment="Left" Padding="14,8" Content="Настроить автозапуск →" />
                  </StackPanel>
                </Border>
                <Button Classes="danger" Content="Восстановить hosts" Click="RestoreHosts_Click" HorizontalAlignment="Stretch" />
              </StackPanel>
            </Grid>

            <Border Classes="card" IsVisible="{Binding HasCleanupItems}">
              <StackPanel Spacing="10"><TextBlock Text="{Binding CleanupTitle}" Classes="sectionTitle" /><ItemsControl ItemsSource="{Binding CleanupItems}"><ItemsControl.ItemTemplate><DataTemplate><TextBlock Text="{Binding}" Margin="0,3" Foreground="#AAB1C2" /></DataTemplate></ItemsControl.ItemTemplate></ItemsControl></StackPanel>
            </Border>
          </StackPanel>
        </ScrollViewer>

        <!-- SERVICES -->
        <Grid IsVisible="{Binding IsServicesPage}" RowDefinitions="Auto,*">
          <Grid Margin="38,32,38,18" ColumnDefinitions="*,Auto">
            <StackPanel Spacing="5"><TextBlock Text="КОНФИГУРАЦИЯ" Classes="eyebrow" /><TextBlock Text="Сервисы" Classes="title" /><TextBlock Text="Выберите сайты и приложения — остальное NetBypass сделает сам." Classes="subtitle" /></StackPanel>
            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Bottom"><Button Content="Очистить" Command="{Binding ClearAllCommand}" /><Button Content="Выбрать все" Command="{Binding SelectAllCommand}" /><Button Classes="primary" Content="Сохранить и применить" Command="{Binding ApplyCommand}" /></StackPanel>
          </Grid>
          <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <StackPanel Margin="38,0,38,40" Spacing="18">
              <Border Classes="card" Background="#17152A" BorderBrush="#3A3262">
                <StackPanel Spacing="13">
                  <Grid ColumnDefinitions="*,Auto"><StackPanel Spacing="4"><TextBlock Text="Anti-DPI маршрутизация" Classes="sectionTitle" /><TextBlock Text="{Binding AntiDpiInstallStatus}" Classes="subtitle" TextWrapping="Wrap" /></StackPanel><Border Grid.Column="1" Padding="11,6" CornerRadius="14" Background="#282047"><TextBlock Text="DEEP MODE" Classes="eyebrow" /></Border></Grid>
                  <ItemsControl ItemsSource="{Binding AntiDpiServices}" IsEnabled="{Binding IsAntiDpiServicesEnabled}">
                    <ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel Orientation="Horizontal" /></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate><DataTemplate><Border Classes="serviceCard" Width="260" Margin="0,0,10,10" Padding="15" CornerRadius="13" Background="#131723" BorderBrush="#2B3040" BorderThickness="1"><CheckBox IsChecked="{Binding IsSelected}"><StackPanel Margin="7,0,0,0" Spacing="3"><TextBlock Text="{Binding Name}" FontWeight="SemiBold" /><TextBlock Text="{Binding Description}" Width="195" TextWrapping="Wrap" FontSize="10" Foreground="{StaticResource MutedBrush}" /><TextBlock Text="{Binding EngineName}" FontSize="9" Foreground="#8B7CFF" /></StackPanel></CheckBox></Border></DataTemplate></ItemsControl.ItemTemplate>
                  </ItemsControl>
                  <Button IsVisible="{Binding IsAntiDpiEngineMissing}" Classes="primary" Content="Скачать GoodbyeDPI" Command="{Binding DownloadGoodbyeDpiCommand}" HorizontalAlignment="Left" />
                </StackPanel>
              </Border>
              <ItemsControl ItemsSource="{Binding Services}">
                <ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel Orientation="Horizontal" /></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate><DataTemplate><Border Classes="card serviceCard" Width="260" MinHeight="92" Margin="0,0,12,12" Padding="16"><CheckBox IsChecked="{Binding IsSelected}"><Grid Margin="7,0,0,0" ColumnDefinitions="*,Auto"><StackPanel Spacing="5"><TextBlock Text="{Binding Name}" FontWeight="SemiBold" FontSize="14" /><TextBlock Text="{Binding Category}" FontSize="10" Foreground="#7F879B" /></StackPanel><Border Grid.Column="1" Padding="8,4" CornerRadius="9" Background="#202637" VerticalAlignment="Top"><TextBlock Text="{Binding EntryCount, StringFormat={}{0} дом.}" FontSize="9" Foreground="#ADB4C4" /></Border></Grid></CheckBox></Border></DataTemplate></ItemsControl.ItemTemplate>
              </ItemsControl>
              <Border IsVisible="{Binding HasOperationMessage}" Classes="card" Padding="15"><TextBlock Text="{Binding OperationMessage}" Foreground="#B7BECE" TextWrapping="Wrap" /></Border>
            </StackPanel>
          </ScrollViewer>
        </Grid>

        <!-- DIAGNOSTICS -->
        <Grid IsVisible="{Binding IsDiagnosticsPage}" RowDefinitions="Auto,*">
          <Grid Margin="38,32,38,18" ColumnDefinitions="*,Auto"><StackPanel Spacing="5"><TextBlock Text="ТЕЛЕМЕТРИЯ" Classes="eyebrow" /><TextBlock Text="Диагностика" Classes="title" /><TextBlock Text="Проверка DNS, TCP и TLS для выбранных направлений." Classes="subtitle" /></StackPanel><StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Bottom"><Button Content="Применить доступные" Command="{Binding ApplyReachableCommand}" IsVisible="{Binding HasUnavailableServices}" /><Button Classes="primary" Content="{Binding DiagnosticButtonText}" Command="{Binding DiagnoseCommand}" /></StackPanel></Grid>
          <ScrollViewer Grid.Row="1"><StackPanel Margin="38,0,38,40" Spacing="16">
            <Border Classes="card" IsVisible="{Binding HasDiagnosticProgress}"><StackPanel Spacing="11"><Grid ColumnDefinitions="*,Auto"><TextBlock Text="Проверяем маршруты…" Classes="sectionTitle" /><TextBlock Grid.Column="1" Text="{Binding DiagnosticProgressText}" Classes="subtitle" /></Grid><ProgressBar Minimum="0" Maximum="100" Value="{Binding DiagnosticProgressPercent}" /></StackPanel></Border>
            <ItemsControl ItemsSource="{Binding Diagnostics}"><ItemsControl.ItemTemplate><DataTemplate><Border Classes="card" Margin="0,0,0,10" Padding="18"><Grid ColumnDefinitions="2*,1.2*,Auto" ColumnSpacing="18"><StackPanel Spacing="4"><TextBlock Text="{Binding ServiceName}" FontSize="15" FontWeight="SemiBold" /><TextBlock Text="{Binding Summary}" Classes="subtitle" TextWrapping="Wrap" /><TextBlock Text="{Binding CheckedAt}" FontSize="10" Foreground="#626A7D" /></StackPanel><StackPanel Grid.Column="1" Spacing="4"><TextBlock Text="ЦЕЛЕВОЙ АДРЕС" Classes="eyebrow" Foreground="#626A7D" /><TextBlock Text="{Binding TargetAddress}" FontFamily="Cascadia Mono, Consolas" FontSize="11" /><TextBlock Text="{Binding DnsAddresses}" FontSize="10" Foreground="#7D8598" TextWrapping="Wrap" /></StackPanel><Border Grid.Column="2" Padding="11,6" CornerRadius="14" Background="#18202A" VerticalAlignment="Top"><TextBlock Text="{Binding StatusText}" Foreground="{Binding StatusColor}" FontWeight="Bold" FontSize="11" /></Border></Grid></Border></DataTemplate></ItemsControl.ItemTemplate></ItemsControl>
          </StackPanel></ScrollViewer>
        </Grid>

        <!-- ENGINES -->
        <Grid IsVisible="{Binding IsEnginesPage}" RowDefinitions="Auto,*">
          <StackPanel Margin="38,32,38,18" Spacing="5"><TextBlock Text="ИНСТРУМЕНТЫ" Classes="eyebrow" /><TextBlock Text="Движки" Classes="title" /><TextBlock Text="Низкоуровневые адаптеры для сложных сценариев блокировок." Classes="subtitle" /></StackPanel>
          <ScrollViewer Grid.Row="1"><StackPanel Margin="38,0,38,40" Spacing="16"><Border Classes="card" Background="#17152A"><StackPanel Spacing="6"><TextBlock Text="Anti-DPI runtime" Classes="sectionTitle" /><TextBlock Text="{Binding GoodbyeDpiRuntimeStatus}" Classes="subtitle" TextWrapping="Wrap" /><TextBlock Text="{Binding EngineOperationMessage}" IsVisible="{Binding HasEngineOperationMessage}" Foreground="#C9C1FF" TextWrapping="Wrap" /></StackPanel></Border><ItemsControl ItemsSource="{Binding Engines}"><ItemsControl.ItemTemplate><DataTemplate><Border Classes="card" Margin="0,0,0,12"><Grid ColumnDefinitions="*,Auto" RowDefinitions="Auto,Auto,Auto"><StackPanel Spacing="4"><TextBlock Text="{Binding Category}" Classes="eyebrow" /><TextBlock Text="{Binding Name}" FontSize="20" FontWeight="Bold" /><TextBlock Text="{Binding Description}" Classes="subtitle" TextWrapping="Wrap" MaxWidth="650" /></StackPanel><Border Grid.Column="1" Padding="12,7" CornerRadius="15" Background="#18202A" VerticalAlignment="Top"><TextBlock Text="{Binding State}" Foreground="{Binding StatusColor}" FontWeight="Bold" FontSize="11" /></Border><StackPanel Grid.Row="1" Margin="0,16,0,0" Spacing="4"><TextBlock Text="ПОДДЕРЖИВАЕМЫЕ СЕРВИСЫ" Classes="eyebrow" Foreground="#626A7D" /><TextBlock Text="{Binding SupportedServicesText}" Foreground="#B6BDCC" TextWrapping="Wrap" /></StackPanel><StackPanel Grid.Row="2" Margin="0,14,0,0" Orientation="Horizontal" Spacing="12"><TextBlock Text="{Binding NextStep}" Classes="subtitle" VerticalAlignment="Center" /><Button Classes="primary" Content="Скачать движок" IsVisible="{Binding ShowDownloadButton}" Command="{Binding $parent[Window].DataContext.DownloadGoodbyeDpiCommand}" /></StackPanel></Grid></Border></DataTemplate></ItemsControl.ItemTemplate></ItemsControl></StackPanel></ScrollViewer>
        </Grid>

        <!-- SETTINGS -->
        <Grid IsVisible="{Binding IsSettingsPage}" RowDefinitions="Auto,*">
          <StackPanel Margin="38,32,38,18" Spacing="5"><TextBlock Text="ПРЕДПОЧТЕНИЯ" Classes="eyebrow" /><TextBlock Text="Настройки" Classes="title" /><TextBlock Text="Поведение приложения и фоновых компонентов." Classes="subtitle" /></StackPanel>
          <ScrollViewer Grid.Row="1"><StackPanel Margin="38,0,38,40" Spacing="16"><Border Classes="card"><Grid ColumnDefinitions="*,Auto"><StackPanel Spacing="7"><TextBlock Text="Автозапуск приложения" Classes="sectionTitle" /><TextBlock Text="После входа в Windows NetBypass незаметно восстановит выбранные Anti-DPI движки. Окно не появится." Classes="subtitle" TextWrapping="Wrap" MaxWidth="650" /><TextBlock Text="{Binding StartupStatus}" FontSize="11" Foreground="#9CA4B6" TextWrapping="Wrap" /><TextBlock Text="{Binding StartupOperationMessage}" IsVisible="{Binding HasStartupOperationMessage}" FontSize="11" Foreground="#C9C1FF" /></StackPanel><ToggleSwitch Grid.Column="1" IsChecked="{Binding StartWithWindows}" IsEnabled="{Binding IsStartupSettingAvailable}" VerticalAlignment="Top" /></Grid></Border><Border Classes="card" Background="#121722"><StackPanel Spacing="7"><TextBlock Text="Принцип безопасности" Classes="sectionTitle" /><TextBlock Text="NetBypass управляет только собственным блоком записей и не затрагивает пользовательские строки hosts. Перед применением адреса проходят сетевую проверку." Classes="subtitle" TextWrapping="Wrap" /></StackPanel></Border></StackPanel></ScrollViewer>
        </Grid>
      </Grid>
    </Grid>

    <!-- In-app confirmation dialog -->
    <Border x:Name="RestoreOverlay" Grid.ColumnSpan="2" Background="#CC070910" IsVisible="False">
      <Border Classes="card" Width="430" HorizontalAlignment="Center" VerticalAlignment="Center" Padding="26" Background="#161A26" BorderBrush="#483342">
        <StackPanel Spacing="16"><Border Width="52" Height="52" CornerRadius="26" Background="#2B1921" HorizontalAlignment="Left"><TextBlock Text="!" FontSize="24" FontWeight="Bold" Foreground="#FF8296" HorizontalAlignment="Center" VerticalAlignment="Center" /></Border><StackPanel Spacing="7"><TextBlock Text="Восстановить hosts?" FontSize="21" FontWeight="Bold" /><TextBlock Text="Будут удалены только записи, добавленные NetBypass. Остальные пользовательские записи останутся без изменений." Classes="subtitle" TextWrapping="Wrap" /></StackPanel><StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Spacing="9"><Button Content="Отмена" Click="CancelRestore_Click" /><Button Classes="danger" Content="Да, восстановить" Click="ConfirmRestore_Click" /></StackPanel></StackPanel>
      </Border>
    </Border>
  </Grid>
</Window>
